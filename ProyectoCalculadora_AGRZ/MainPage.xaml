<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="ProyectoCalculadora_AGRZ.MainPage"
             Title="Calculadora"
             BackgroundColor="Black">

    <ContentPage.Resources>
        <Style x:Key="BtnNum" TargetType="Button">
            <Setter Property="BackgroundColor" Value="#333333" />
            <Setter Property="TextColor" Value="White" />
            <Setter Property="FontSize" Value="32" />
            <Setter Property="CornerRadius" Value="40" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Margin" Value="6" />
        </Style>
        <Style x:Key="BtnFn" TargetType="Button" BasedOn="{StaticResource BtnNum}">
            <Setter Property="BackgroundColor" Value="#A5A5A5" />
            <Setter Property="TextColor" Value="Black" />
        </Style>
        <Style x:Key="BtnOp" TargetType="Button" BasedOn="{StaticResource BtnNum}">
            <Setter Property="BackgroundColor" Value="#FF9F0A" />
            <Setter Property="TextColor" Value="White" />
            <Setter Property="FontSize" Value="36" />
        </Style>
    </ContentPage.Resources>

    <Grid Padding="10,10,10,16" RowDefinitions="2*,5*">

        <VerticalStackLayout Grid.Row="0" VerticalOptions="End" Padding="12,0,12,8">
            <Label x:Name="Historial" FontSize="18" TextColor="#9A9A9A"
                   HorizontalTextAlignment="End" LineBreakMode="TailTruncation" MaxLines="1" />
            <Label x:Name="Pantalla" Text="0" FontSize="64" TextColor="White"
                   HorizontalTextAlignment="End" LineBreakMode="NoWrap" MaxLines="1" />
        </VerticalStackLayout>

        <Grid x:Name="Teclado" Grid.Row="1"
              RowDefinitions="*,*,*,*,*" ColumnDefinitions="*,*,*,*">

            <Button Text="AC" Grid.Row="0" Grid.Column="0" Style="{StaticResource BtnFn}" Clicked="OnLimpiar" />
            <Button Text="⌫"  Grid.Row="0" Grid.Column="1" Style="{StaticResource BtnFn}" Clicked="OnBorrar" />
            <Button Text="%"  Grid.Row="0" Grid.Column="2" Style="{StaticResource BtnFn}" Clicked="OnPorcentaje" />
            <Button Text="÷"  Grid.Row="0" Grid.Column="3" Style="{StaticResource BtnOp}" Clicked="OnOperador" />

            <Button Text="7" Grid.Row="1" Grid.Column="0" Style="{StaticResource BtnNum}" Clicked="OnNumero" />
            <Button Text="8" Grid.Row="1" Grid.Column="1" Style="{StaticResource BtnNum}" Clicked="OnNumero" />
            <Button Text="9" Grid.Row="1" Grid.Column="2" Style="{StaticResource BtnNum}" Clicked="OnNumero" />
            <Button Text="×" Grid.Row="1" Grid.Column="3" Style="{StaticResource BtnOp}" Clicked="OnOperador" />

            <Button Text="4" Grid.Row="2" Grid.Column="0" Style="{StaticResource BtnNum}" Clicked="OnNumero" />
            <Button Text="5" Grid.Row="2" Grid.Column="1" Style="{StaticResource BtnNum}" Clicked="OnNumero" />
            <Button Text="6" Grid.Row="2" Grid.Column="2" Style="{StaticResource BtnNum}" Clicked="OnNumero" />
            <Button Text="-" Grid.Row="2" Grid.Column="3" Style="{StaticResource BtnOp}" Clicked="OnOperador" />

            <Button Text="1" Grid.Row="3" Grid.Column="0" Style="{StaticResource BtnNum}" Clicked="OnNumero" />
            <Button Text="2" Grid.Row="3" Grid.Column="1" Style="{StaticResource BtnNum}" Clicked="OnNumero" />
            <Button Text="3" Grid.Row="3" Grid.Column="2" Style="{StaticResource BtnNum}" Clicked="OnNumero" />
            <Button Text="+" Grid.Row="3" Grid.Column="3" Style="{StaticResource BtnOp}" Clicked="OnOperador" />

            <Button Text="0" Grid.Row="4" Grid.Column="0" Grid.ColumnSpan="2" Style="{StaticResource BtnNum}" Clicked="OnNumero" />
            <Button Text="." Grid.Row="4" Grid.Column="2" Style="{StaticResource BtnNum}" Clicked="OnPunto" />
            <Button Text="=" Grid.Row="4" Grid.Column="3" Style="{StaticResource BtnOp}" Clicked="OnIgual" />
        </Grid>
    </Grid>
</ContentPage>